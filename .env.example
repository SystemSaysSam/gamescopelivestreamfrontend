# =====================================================================
# GameScope Live — Public Frontend Environment Variables
# Note: Vite environment variables are embedded into client bundles at build time.
# A rebuild (`npm run build`) is required when changing these values.
# =====================================================================

# Backend REST API endpoint (Production: https://gamescopeserver.5tart.sbs | Local: http://localhost:5000)
VITE_API_URL=https://gamescopeserver.5tart.sbs

# Backend Socket.IO realtime endpoint (Production: https://gamescopeserver.5tart.sbs | Local: http://localhost:5000)
VITE_SOCKET_URL=https://gamescopeserver.5tart.sbs

# Web Push API (VAPID) Public Key (Must match backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBKr3qBUYIHBQFLXYp5Nksh8U

# Optional static asset CDN base URL (defaults to local public/ folder if unset)
VITE_ASSET_BASE_URL=
